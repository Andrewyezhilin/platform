<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartlife.mapper.VoucherOrderMapper">

    <resultMap id="BaseResultMap" type="com.smartlife.entity.VoucherOrder">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="voucher_id" property="voucherId"/>
        <result column="pay_type" property="payType"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="pay_time" property="payTime"/>
        <result column="use_time" property="useTime"/>
        <result column="refund_time" property="refundTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.smartlife.entity.VoucherOrder">
        INSERT INTO tb_voucher_order (id, user_id, voucher_id, pay_type, status)
        VALUES (#{id}, #{userId}, #{voucherId}, #{payType}, #{status})
    </insert>

    <select id="countByUserIdAndVoucherId" resultType="int">
        SELECT COUNT(*)
        FROM tb_voucher_order
        WHERE user_id = #{userId} AND voucher_id = #{voucherId}
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT id, user_id, voucher_id, pay_type, status,
               create_time, pay_time, use_time, refund_time, update_time
        FROM tb_voucher_order
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>
</mapper>
